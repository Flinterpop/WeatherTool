// Version resource and the Add place dialog. The version numbers come from
// CMake (project(... VERSION)) via WEATHERTOOL_VERSION_* so the numeric
// tuple and the strings cannot disagree.
#include <windows.h>

#include "resource.h"

#define WT_STR_(x) #x
#define WT_STR(x)  WT_STR_(x)
#define WT_VERSION_STR WT_STR(WEATHERTOOL_VERSION_MAJOR) "." WT_STR(WEATHERTOOL_VERSION_MINOR) "." WT_STR(WEATHERTOOL_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WEATHERTOOL_VERSION_MAJOR, WEATHERTOOL_VERSION_MINOR, WEATHERTOOL_VERSION_PATCH, 0
PRODUCTVERSION WEATHERTOOL_VERSION_MAJOR, WEATHERTOOL_VERSION_MINOR, WEATHERTOOL_VERSION_PATCH, 0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "WeatherTool - historical temperature and snowfall"
            VALUE "FileVersion",      WT_VERSION_STR
            VALUE "InternalName",     "WeatherTool"
            VALUE "OriginalFilename", "WeatherTool.exe"
            VALUE "ProductName",      "WeatherTool"
            VALUE "ProductVersion",   WT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_ADDPLACE DIALOGEX 0, 0, 300, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add place"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Search for a town or city:", -1, 7, 7, 286, 8
    EDITTEXT        IDC_QUERY, 7, 18, 236, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Search", IDC_SEARCH, 247, 17, 46, 15
    LISTBOX         IDC_RESULTS, 7, 36, 286, 110, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_HINT, 7, 151, 286, 8
    DEFPUSHBUTTON   "Add", IDOK, 189, 161, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 243, 161, 50, 14
END
